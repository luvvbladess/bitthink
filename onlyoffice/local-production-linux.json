{
  "services": {
    "CoAuthoring": {
      "autoAssembly": {
        "enable": true,
        "interval": "1m",
        "step": "1m"
      },
      "callbackBackoffOptions": {
        "retries": 6,
        "timeout": {
          "factor": 2,
          "minTimeout": 1000,
          "maxTimeout": 30000,
          "randomize": false
        },
        "httpStatus": "429,500-599"
      }
    }
  }
}
