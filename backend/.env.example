SECRET_KEY=change-me-in-production
APP_NAME=Bit-Think
DEBUG=true
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: SQLite by default for local dev, PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://gpt_user:gpt_pass@localhost:5432/gpt_ultra

# LLM API keys
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6

# Optional proxies
PROXY_URL=
RU_PROXY_URL=

# Document editor (OnlyOffice, compose profile "editor"). Empty secret = editor off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ONLYOFFICE_JWT_SECRET=
# Public site address, used for the AI plugin URL. Empty = taken from the browser.
PUBLIC_APP_URL=
